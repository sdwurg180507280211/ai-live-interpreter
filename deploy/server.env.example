# 复制为 deploy/server.env 后按服务器实际情况填写（server.env 不提交到 git）。
# deploy.sh 会把路由挂进这个 Caddy 的第一个 route 块，改完校验配置并重启它。

# Caddy 主配置文件
CADDYFILE=/etc/caddy/Caddyfile
# Caddy 服务的环境变量文件（配置里用到 {$VAR} 时需要；没有可指向空文件）
CADDY_ENV=/etc/caddy/caddy.env
# Caddy 可执行文件
CADDY_BIN=/usr/bin/caddy
# systemd 服务名
CADDY_UNIT=caddy.service
# Caddy 服务的运行用户
CADDY_USER=caddy
# Caddy 的数据目录（证书存储）
CADDY_DATA=/var/lib/caddy
