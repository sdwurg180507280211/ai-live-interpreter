# 复制为 .env 后填写。.env 已在 .gitignore 中，不会提交。

# —— 火山引擎 · 豆包同声传译 2.0 ——
# 控制台：https://console.volcengine.com/speech/new → API Key
VOLC_API_KEY=
# 资源 ID 是固定值，一般不用改
VOLC_AST_RESOURCE_ID=volc.service_type.10053
# 源语言和目标语言（en 英语 / zh 中文，其他语种见官方文档）
SOURCE_LANGUAGE=en
TARGET_LANGUAGE=zh
# 服务端降噪，现场噪音大时可以试试
AST_DENOISE=0

# —— 显示 ——
# 127.0.0.1 只允许本机访问；0.0.0.0 允许同一局域网的平板访问
HOST=127.0.0.1
PORT=8765

# 术语表，默认读取项目根目录 glossary.txt，格式见 glossary.example.txt
# GLOSSARY_FILE=glossary.txt

# —— 产品名称 ——
# 显示在登录页、控制台和字幕屏上，给不同客户可以换成各自的名字
# BRAND_NAME=AI 同传
